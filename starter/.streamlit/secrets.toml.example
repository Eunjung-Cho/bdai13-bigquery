# 실제 secrets.toml은 GitHub에 올리지 않습니다.
[data]
backend = "bigquery"
# 아래 두 값은 학생 본인의 실행 프로젝트와 5주차 마트로 변경합니다.
query_project = "YOUR_PROJECT"
table = "YOUR_PROJECT.bdai13.mart_monthly_mcc"
# 원천/마트의 실제 리전으로 변경하세요.
location = "US"
maximum_bytes_billed = 100000000

# Community Cloud에서는 Settings > Secrets에 아래 블록을 넣습니다.
# Google에서 발급한 JSON의 필드를 같은 이름으로 옮기세요.
# 키를 AI 프롬프트나 GitHub 코드에 붙이지 않습니다.
[gcp_service_account]
type = "service_account"
project_id = "YOUR_PROJECT"
private_key_id = "REPLACE_LOCALLY"
private_key = "REPLACE_LOCALLY"
client_email = "REPLACE_LOCALLY"
client_id = "REPLACE_LOCALLY"
token_uri = "https://oauth2.googleapis.com/token"

